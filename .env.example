# =============================================================================
# KNOROOMS — Variables de entorno de ejemplo (Infraestructura y Backend)
# Copie este archivo a `.env` para desarrollo local. NUNCA versione `.env`.
# =============================================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_PORT=5432
POSTGRES_DB=knorooms
POSTGRES_SUPERUSER=knorooms_migrator
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_LOCAL_DEV_MIGRATOR
POSTGRES_APP_USER=knorooms_app
POSTGRES_APP_PASSWORD=CHANGE_ME_LOCAL_DEV_APP

# --- Redis (Almacén de sesiones del BFF Next.js) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend ASP.NET Core (.NET 10) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=knorooms;Username=knorooms_app;Password=CHANGE_ME_LOCAL_DEV_APP
Tenancy__BaseDomain=localhost
Tenancy__PlatformSubdomain=admin
Authentication__Oidc__Authority=http://localhost:8080/realms/knorooms
Authentication__Oidc__Audience=knorooms-api
Authentication__Oidc__RequireHttpsMetadata=false
Authentication__Oidc__EnforceMfaForPrivilegedRoles=false

# --- Proveedor OIDC opcional en Docker (Keycloak perfil `oidc`) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_KEYCLOAK

# ==============================================================================
# KNOROOMS Web & BFF — Variables de Entorno (.env.example)
# Copiar a .env.local para desarrollo local. NUNCA commitear secretos reales.
# ==============================================================================

# --- Dominio y Multi-tenancy ---
# Dominio raíz de la aplicación (en local: localhost, en producción: knorooms.com)
APP_BASE_DOMAIN=localhost
# Subdominio reservado para el portal de administración global de la plataforma
PLATFORM_SUBDOMAIN=admin

# --- Backend API interna (consumida exclusivamente por el BFF) ---
API_BASE_URL=http://localhost:5080

# --- Almacenamiento de Sesiones (Redis) ---
REDIS_URL=redis://localhost:6379

# Clave simétrica de 32 bytes codificada en Base64 para cifrado AES-256-GCM de tokens en Redis.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# En producción DEBE ser true (usa cookie __Host-knorooms_session con Secure).
# En desarrollo local sobre HTTP sin TLS usar false (usa cookie knorooms_session).
SESSION_COOKIE_SECURE=false

# Políticas de expiración de sesión (en minutos)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

# --- Autenticación ---
# El BFF autentica usuario/contraseña contra el backend propio (POST /api/auth/login)
# y gestiona la sesión en el servidor. No hay proveedor de identidad externo ni OAuth/OIDC.

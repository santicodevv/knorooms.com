{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=knorooms;Username=knorooms_app;Password=knorooms_local_dev_app"
  },
  "Database": {
    "AutoMigrateOnStartup": true,
    "SeedDevelopmentData": true,
    "EnableOutboxWorker": true
  },
  "Tenancy": {
    "BaseDomain": "localhost",
    "PlatformSubdomain": "admin"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "http://localhost:8080/realms/knorooms",
      "Audience": "knorooms-api",
      "RequireHttpsMetadata": false,
      "ClockSkewSeconds": 30,
      "ExpectedAccessTokenMaxLifetimeMinutes": 15,
      "EnforceMfaForPrivilegedRoles": false
    }
  }
}

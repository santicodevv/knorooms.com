{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=knorooms;Username=knorooms_app;Password="
  },
  "Database": {
    "AutoMigrateOnStartup": false,
    "SeedDevelopmentData": false,
    "EnableOutboxWorker": true
  },
  "Tenancy": {
    "BaseDomain": "knorooms.com",
    "PlatformSubdomain": "admin"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "Audience": "knorooms-api",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 30,
      "ExpectedAccessTokenMaxLifetimeMinutes": 15,
      "EnforceMfaForPrivilegedRoles": true,
      "AcceptedMfaClaimValues": [
        "mfa",
        "otp",
        "totp",
        "hwk",
        "swk",
        "urn:keycloak:acr:2fa"
      ]
    }
  }
}

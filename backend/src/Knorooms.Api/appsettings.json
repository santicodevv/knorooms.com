{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=knorooms;Username=knorooms_app;Password="
  },
  "Database": {
    "AutoMigrateOnStartup": false,
    "SeedDevelopmentData": false,
    "EnableOutboxWorker": true
  },
  "Tenancy": {
    "BaseDomain": "knorooms.com",
    "PlatformSubdomain": "admin"
  },
  "Authentication": {
    "Tokens": {
      "Issuer": "https://knorooms.com",
      "Audience": "knorooms-api",
      "SigningKey": "",
      "ClockSkewSeconds": 30,
      "EnforceMfaForPrivilegedRoles": true,
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 5
    },
    "PasswordPolicy": {
      "MinimumLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    }
  }
}
